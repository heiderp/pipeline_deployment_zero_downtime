# ─────────────────────────────────────────────────────────────
# Local development environment variables
# Copy to .env and fill in your values: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_ACCOUNT_ID=CHANGE_ME

# ECR
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

# RDS (local dev — use RDS endpoint after Terraform apply)
DATABASE_URL=postgresql://appuser:password@localhost:5432/appdb
RDS_HOST=localhost
RDS_PORT=5432
RDS_DB=appdb
RDS_USER=appuser
RDS_PASSWORD=CHANGE_ME

# SQS (local dev — use LocalStack or real SQS)
SQS_QUEUE_URL=http://localhost:4566/000000000000/tasks-queue
SQS_DLQ_URL=http://localhost:4566/000000000000/tasks-dlq

# SNS (local dev — use LocalStack or real SNS)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:events-topic

# ALB (after Terraform apply, replaces LocalStack values)
ALB_DNS_NAME=localhost
ALB_LISTENER_ARN=CHANGE_ME

# Per-service target group ARNs (from terraform output)
FLASK_BLUE_TG_ARN=CHANGE_ME
FLASK_GREEN_TG_ARN=CHANGE_ME
NODE_BLUE_TG_ARN=CHANGE_ME
NODE_GREEN_TG_ARN=CHANGE_ME
SPRING_BLUE_TG_ARN=CHANGE_ME
SPRING_GREEN_TG_ARN=CHANGE_ME

# Slack notifications
SLACK_WEBHOOK_URL=

# Environment
ENVIRONMENT=dev
